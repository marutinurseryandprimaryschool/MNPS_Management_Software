rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Check if user is admin
    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper: Check if user is admin-like (admin, principal, correspondent)
    function isAdminLike() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'principal', 'correspondent'];
    }

    // Helper: Check if user is the principal (sole money writer)
    function isPrincipal() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'principal';
    }

    // Helper: Check if user can manage other users (principal excluded)
    function isUserManager() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'correspondent'];
    }

    // Users collection — redesigned: no self-service privilege escalation
    match /users/{userId} {
      allow read: if isAuthenticated();

      // Parent self-signup (incl. anonymous sessions): own-uid doc, role locked to 'parent'
      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.role == 'parent';

      // Staff first-login migration: own-uid doc with a privileged role, only when
      // migratedFrom references a pre-registration doc that is pending, matches the
      // verified sign-in email, and carries the SAME role (no role upgrades in transit).
      // Batch get() sees pre-batch state, so the atomic swap (set + delete) works.
      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && request.auth.token.email_verified == true
        && 'migratedFrom' in request.resource.data
        && request.resource.data.migratedFrom is string
        && get(/databases/$(database)/documents/users/$(request.resource.data.migratedFrom)).data.status == 'pending'
        && get(/databases/$(database)/documents/users/$(request.resource.data.migratedFrom)).data.email == request.auth.token.email
        && get(/databases/$(database)/documents/users/$(request.resource.data.migratedFrom)).data.role == request.resource.data.role;

      // Self-update: role and studentId are immutable (pinned at create)
      allow update: if isAuthenticated()
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'studentId']);

      // User management (other users' docs): admin + correspondent only
      allow create, update, delete: if isUserManager();

      // Let a freshly-logged-in user delete their own pending pre-registration doc
      // so the active UID-keyed doc replaces it (migration batch's delete half).
      allow delete: if isAuthenticated()
        && resource.data.status == 'pending'
        && resource.data.email == request.auth.token.email;
    }

    // School settings (singleton doc)
    match /school/{docId} {
      allow read: if true;
      allow write: if isAdminLike();
      allow create: if isAuthenticated();
    }

    // Students
    match /students/{studentId} {
      allow read: if isAuthenticated();
      allow write: if isAdminLike();
    }

    // Teachers
    match /teachers/{teacherId} {
      allow read: if isAuthenticated();
      allow write: if isAdminLike();
    }

    // Classes
    match /classes/{classId} {
      allow read: if isAuthenticated();
      allow write: if isAdminLike();
    }

    // Timetables
    match /timetables/{timetableId} {
      allow read: if isAuthenticated();
      allow write: if isAdminLike();
    }

    // Attendance
    match /attendance/{attendanceId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Marks
    match /marks/{marksId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Teacher Assignments
    match /teacherAssignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow write: if isAdminLike();
    }

    // Assignments
    match /assignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Materials
    match /materials/{materialId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Fee Structures
    match /feeStructures/{feeId} {
      allow read: if isAuthenticated();
      allow write: if isAdminLike();
    }

    // Fee Payments — Principal is the sole writer; reads stay open for
    // parent/teacher views (client-side scoping, documented trust boundary).
    // No hard delete: soft delete is an update setting deleted:true.
    match /feePayments/{paymentId} {
      allow read: if isAuthenticated();
      allow create, update: if isPrincipal();
      allow delete: if false;

      // Write-once audit trail, paired with payment mutations in one writeBatch
      match /history/{entryId} {
        allow read, create: if isPrincipal();
        allow update, delete: if false;
      }
    }

    // Chats
    match /chats/{chatId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();

      match /messages/{messageId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();
      }
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated();
      allow write: if isAdminLike();
      allow update: if isAuthenticated();
    }

    // Report Cards
    match /reportCards/{reportCardId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Co-Scholastic Records
    match /coScholasticRecords/{recordId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Bus Routes
    match /busRoutes/{routeId} {
      allow read: if isAuthenticated();
      allow write: if isAdminLike();
    }

    // Weekly Tests
    match /weeklyTests/{testId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Class Tests — per-test marks entered by teachers
    match /classTests/{testId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Expenses — Principal-only module; no hard delete (soft delete via update)
    match /expenses/{expenseId} {
      allow read: if isPrincipal();
      allow create, update: if isPrincipal();
      allow delete: if false;

      // Write-once audit trail, paired with expense mutations in one writeBatch
      match /history/{entryId} {
        allow read, create: if isPrincipal();
        allow update, delete: if false;
      }
    }

    // Assessment Sessions
    match /assessmentSessions/{sessionId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Academic Calendars
    match /academicCalendars/{year} {
      allow read: if isAuthenticated();
      allow write: if isAdminLike();
    }

    // Accounts — opening balances / reconciliation docs; strictly Principal
    match /accounts/{docId} {
      allow read, write: if isPrincipal();
    }

    // ─────────────────────────────────────────────────────────────────────
    // Principal Register (standalone module — shares NO data with the
    // legacy feePayments/feeStructures/expenses collections above).
    // ─────────────────────────────────────────────────────────────────────

    // Helper: the caller's role as RECORDED IN users/{uid}, or '' when they
    // have no user doc at all.
    //
    // The '' case is the one that matters. AuthContext.loginAsParent signs in
    // anonymously BEFORE it matches the login code against a student (it has
    // to — reading /students needs a session), and anyone holding the public
    // web config can call signInAnonymously directly. Such a session satisfies
    // isAuthenticated() while owning no user doc, so every rule below tests a
    // ROLE rather than mere authentication.
    function principalUserRole() {
      return (isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '')
        : '';
    }

    // Teacher / staff — the two roles that share the teacher shell and may be
    // made responsible for a register row.
    function isTeacherLike() {
      return principalUserRole() in ['teacher', 'staff'];
    }

    // Who may read the register at all. Admin and correspondent are OUT: this
    // module is the Principal's, and they hold no register capability in
    // src/lib/permissions.ts either.
    function readsPrincipalModule() {
      return principalUserRole() in ['principal', 'teacher', 'staff', 'parent'];
    }

    // Helper: the signed-in user is the teacher responsible for this register row.
    // teacherUid is optional/nullable on RegisterRow, so read it defensively —
    // a bare resource.data.teacherUid would error (and deny) on unassigned rows.
    function ownsRegisterRow(rowData) {
      return isAuthenticated() && rowData.get('teacherUid', '') == request.auth.uid;
    }

    // Helper: the signed-in user owns the principalRegister row identified by rowId.
    // exists() guards the get(): a get() on a missing doc errors out and denies.
    function ownsRegisterRowId(rowId) {
      return isAuthenticated()
        && rowId is string
        && rowId.size() > 0
        && exists(/databases/$(database)/documents/principalRegister/$(rowId))
        && ownsRegisterRow(get(/databases/$(database)/documents/principalRegister/$(rowId)).data);
    }

    // Helper: a teacher edit may only move the fee fields. Identity fields
    // (name, className, sectionName, rollNo), the assignment field (teacherUid /
    // teacherName), academicYear and the soft-delete flag stay principal-only.
    function touchesOnlyTeacherFeeFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'schoolFee', 'ecaAnnual', 'ecaMonths', 'vanMonthly', 'vanMonths',
        'isScholarship', 'notes', 'updatedAt'
      ]);
    }

    // Helper: the business date has been CLOSED by the Principal's day-close
    // reconciliation. A closed date rejects new or edited money movements on
    // that date until the Principal reopens it (principalDayClose update) —
    // reopen → correct → close again is the auditable correction path.
    // An empty/missing key reads as not-closed, so legacy docs stay editable.
    function isDayClosed(dateKey) {
      return dateKey is string
        && dateKey.size() > 0
        && exists(/databases/$(database)/documents/principalDayClose/$(dateKey))
        && get(/databases/$(database)/documents/principalDayClose/$(dateKey)).data.status == 'closed';
    }

    // Helper: the value fields of a NEW payment, pinned.
    //
    // Attribution is pinned to the SIGNED-IN uid, not to whatever the client
    // put in the document — without this a teacher can record cash as the
    // Principal and every "entered by" column downstream believes it. The
    // amount/head/mode checks stop a negative or nonsense receipt from
    // reaching the engine, `deleted == false` stops a payment being born
    // already hidden, and academicYear is forced to the row's own year so a
    // receipt cannot be parked in a year the Principal never opens.
    function pinnedNewPayment() {
      return request.resource.data.keys().hasAll([
          'rowId', 'academicYear', 'enteredByUid', 'amount', 'head', 'mode',
          'dateKey', 'deleted', 'createdAt'
        ])
        && request.resource.data.enteredByUid == request.auth.uid
        && request.resource.data.deleted == false
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.head in ['school', 'eca', 'van', 'other']
        && request.resource.data.mode in ['cash', 'upi', 'bank', 'other']
        && request.resource.data.dateKey is string
        && request.resource.data.createdAt == request.time
        && request.resource.data.rowId is string
        && request.resource.data.rowId.size() > 0
        && exists(/databases/$(database)/documents/principalRegister/$(request.resource.data.rowId))
        && request.resource.data.academicYear
             == get(/databases/$(database)/documents/principalRegister/$(request.resource.data.rowId)).data.academicYear;
    }

    // Principal Register rows — the "fees note" Sharmi types into.
    //
    // TRUST BOUNDARY (documented, and narrower than it used to be): reads are
    // open to every ROLE that has business here — principal, teacher/staff and
    // parent — and to nobody else. A session with no users/{uid} doc (the
    // anonymous one the parent login holds before its code is matched, or one
    // minted straight from the public web config) reads nothing.
    //
    // Residual, accepted risk: a signed-in parent still sees the whole
    // collection, because their view of "my child's row" is matched CLIENT-SIDE
    // by name+class (ParentFees.findRowForChild) and no studentId links a row
    // to a family. Closing that needs studentId on RegisterRow plus a
    // studentId-constrained parent query — a data migration, not a rule edit.
    //
    // No hard delete: rows are soft-deleted (deleted: true) via update, so the
    // audit trail and every payment that references the row stay intact.
    match /principalRegister/{rowId} {
      allow read: if readsPrincipalModule();
      allow create: if isPrincipal();
      allow update: if isPrincipal()
        || (isTeacherLike() && ownsRegisterRow(resource.data) && touchesOnlyTeacherFeeFields());
      allow delete: if false;
    }

    // Principal payments — the Principal records anything; a teacher may only
    // CREATE a receipt against a row assigned to them, with their own uid on it.
    //
    // Editing and soft-deleting a payment are principal-only, matching
    // src/lib/permissions.ts (teachers hold recordPrincipalPayments and nothing
    // else) and principal-service's own denial text. A teacher branch here
    // would have let the responsible teacher zero out, re-date, re-bank or
    // soft-delete money the Principal herself recorded.
    // Reads follow the same role boundary as the register above.
    // No hard delete: soft delete is an update setting deleted:true.
    match /principalPayments/{paymentId} {
      allow read: if readsPrincipalModule();
      // A payment cannot be born on a CLOSED business date (day-close, §18) —
      // the Principal reopens the day first, corrects, and closes it again.
      allow create: if (isPrincipal()
                        || (isTeacherLike()
                            && ownsRegisterRowId(request.resource.data.get('rowId', ''))))
        && pinnedNewPayment()
        && !isDayClosed(request.resource.data.dateKey);
      // Edits (incl. soft-delete) are blocked while the payment's day — old
      // OR new, so money can't be moved INTO a closed day either — is closed.
      allow update: if isPrincipal()
        && !isDayClosed(resource.data.get('dateKey', ''))
        && !isDayClosed(request.resource.data.get('dateKey', ''));
      allow delete: if false;
    }

    // Principal expenses — strictly Principal, reads included (expense detail
    // is not teacher-visible). No hard delete: soft delete via update.
    match /principalExpenses/{expenseId} {
      allow read: if isPrincipal();
      // Same closed-day protection as payments (§18).
      allow create: if isPrincipal()
        && !isDayClosed(request.resource.data.get('dateKey', ''));
      allow update: if isPrincipal()
        && !isDayClosed(resource.data.get('dateKey', ''))
        && !isDayClosed(request.resource.data.get('dateKey', ''));
      allow delete: if false;
    }

    // Day-close reconciliation (Phase 3 §16–§18) — one doc per business date,
    // the doc id IS the date. Strictly Principal: expected/actual cash counts
    // are exactly the numbers a teacher or parent must not see.
    // Create = closing a day: every field pinned, the arithmetic re-checked
    // server-side, attribution forced to the signed-in Principal, status born
    // 'closed'. Update = reopening (status 'reopened') or re-closing with a
    // fresh count; the date itself is immutable. Never deletable — a day that
    // was once closed keeps its trail.
    match /principalDayClose/{dateKey} {
      allow read: if isPrincipal();
      allow create: if isPrincipal()
        && request.resource.data.keys().hasAll([
             'dateKey', 'academicYear', 'expectedCash', 'actualCash', 'difference',
             'assessment', 'status', 'closedByUid', 'closedByName', 'closedAt', 'updatedAt'
           ])
        && request.resource.data.dateKey == dateKey
        && request.resource.data.expectedCash is number
        && request.resource.data.actualCash is number
        && request.resource.data.actualCash >= 0
        && request.resource.data.difference
             == request.resource.data.actualCash - request.resource.data.expectedCash
        && request.resource.data.assessment in ['matched', 'short', 'excess']
        && request.resource.data.status == 'closed'
        && request.resource.data.closedByUid == request.auth.uid
        && request.resource.data.closedAt == request.time;
      allow update: if isPrincipal()
        && request.resource.data.dateKey == dateKey
        && request.resource.data.status in ['closed', 'reopened']
        && request.resource.data.actualCash is number
        && request.resource.data.actualCash >= 0
        && request.resource.data.difference
             == request.resource.data.actualCash - request.resource.data.expectedCash;
      allow delete: if false;
    }

    // Principal audit log — write-once, and the module's whole integrity story.
    //
    // A teacher must be able to create an entry (their own edit is logged in
    // the SAME writeBatch as the change, so an unwritable entry would fail the
    // mutation atomically) — but ONLY as themselves:
    //   - actorUid is pinned to the signed-in uid and actorRole to the role
    //     users/{uid} actually records, so nothing can be attributed to Sharmi
    //     by someone else;
    //   - `at` must be the SERVER's clock. A caller-set `at` far in the future
    //     would push every genuine entry off the end of
    //     PrincipalAuditService.listRecent (orderBy at desc, limit 100) — a
    //     permanent eviction, because entries can never be deleted;
    //   - action/target are closed vocabularies, targetId must be present.
    // Reads stay principal-only; nothing may ever update or delete an entry.
    match /principalAudit/{entryId} {
      allow read: if isPrincipal();
      allow create: if (isPrincipal() || isTeacherLike())
        && request.resource.data.keys().hasAll([
             'actorUid', 'actorRole', 'at', 'action', 'target', 'targetId', 'summary'
           ])
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorRole == principalUserRole()
        && request.resource.data.at == request.time
        && request.resource.data.action in ['create', 'update', 'delete']
        && request.resource.data.target in ['register', 'payment', 'expense', 'settings', 'dayclose']
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() > 0
        && request.resource.data.summary is string;
      allow update, delete: if false;
    }

    // Principal settings (opening balances, default month sets, expense
    // categories). Readable by every role in the module because the register
    // screens need defaultEcaMonths/defaultVanMonths to render; principal-only
    // writes.
    match /principalSettings/{docId} {
      allow read: if readsPrincipalModule();
      allow write: if isPrincipal();
    }
  }
}
